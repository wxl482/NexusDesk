# ===================================================
# NexusDesk Agent Backend Configuration
# ===================================================

# FastAPI Server Port
PORT=8000
HOST=127.0.0.1
DEBUG=True
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1

# Default LLM Settings (OpenAI Compatible)
# Presets:
# DeepSeek: https://api.deepseek.com/v1 (model: deepseek-chat or deepseek-reasoner)
# OpenAI: https://api.openai.com/v1 (model: gpt-4o or gpt-4o-mini)
# Ollama: http://localhost:11434/v1 (model: llama3.2)
# Moonshot: https://api.moonshot.cn/v1 (model: moonshot-v1-8k)
# Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1 (model: qwen-turbo)

DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com/v1
DEFAULT_API_KEY=your_llm_api_key_here
DEFAULT_TEMPERATURE=0.7

# 智谱 AI 向量嵌入模型配置 (ZhipuAI Embedding)
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
EMBEDDING_MODEL=embedding-3

# Milvus 向量数据库配置（默认连接 Docker 本地服务端；填本地文件路径可回退 Milvus Lite 单文件）
# Docker 服务端: http://localhost:19530 (docker compose up -d 启动)
# 本地单文件: data/milvus/nexusdesk.db
# 云端全托管 (Zilliz Cloud): https://in03-xxxx.zillizcloud.com
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# PostgreSQL 配置（LangGraph 会话检查点持久化；连接失败自动回退内存检查点）
POSTGRES_URI=postgresql://nexusdesk:nexusdesk@localhost:5432/nexusdesk

# 实时搜索引擎 API Key (Tavily API)
TAVILY_API_KEY=your_tavily_api_key_here
