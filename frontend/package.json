{
  "name": "nexusdesk",
  "version": "1.0.0",
  "description": "NexusDesk - Intelligent AI Agent Desktop Workstation built with Electron, Vue 3, and LangChain/LangGraph",
  "homepage": "https://github.com/wxl482/NexusDesk",
  "author": {
    "name": "wxl482",
    "email": "wxl482@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:vue": "vite build",
    "package": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "postinstall": "node node_modules/electron/install.js && (codesign --force --deep --sign - node_modules/electron/dist/Electron.app 2>/dev/null || true)"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "lucide-vue-next": "^0.439.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.39.0",
    "pinia": "^2.2.2",
    "vfonts": "^0.1.0",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.16.5",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.1.4"
  },
  "build": {
    "appId": "com.nexusdesk.app",
    "productName": "NexusDesk",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wxl482",
        "repo": "NexusDesk"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "maintainer": "wxl482 <wxl482@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Utility"
    }
  }
}
