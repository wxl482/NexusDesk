{
  "name": "nexusdesk",
  "version": "1.0.0",
  "description": "NexusDesk - Intelligent AI Agent Desktop Workstation built with Electron, Vue 3, and LangChain/LangGraph",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:vue": "vite build",
    "package": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "postinstall": "node node_modules/electron/install.js && (codesign --force --deep --sign - node_modules/electron/dist/Electron.app 2>/dev/null || true)"
  },
  "dependencies": {
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "pinia": "^2.2.2",
    "naive-ui": "^2.39.0",
    "vfonts": "^0.1.0",
    "lucide-vue-next": "^0.439.0",
    "markdown-it": "^14.1.0",
    "highlight.js": "^11.10.0",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.1.4"
  }
}
